{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@labubu/common": ["../common/src"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}

